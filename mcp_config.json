{
  "mcpServers": {
    "mail": {
      "command": "node",
      "args": ["${PLUGIN_ROOT}/index.mjs"],
      "env": {
        "GMAIL_USER": "${GMAIL_USER}",
        "GMAIL_APP_PASSWORD": "${GMAIL_APP_PASSWORD}"
      },
      "variables": [
        {
          "name": "GMAIL_USER",
          "title": "Gmail 邮箱地址",
          "description": "例如 yourname@gmail.com"
        },
        {
          "name": "GMAIL_APP_PASSWORD",
          "title": "Google 应用专用密码（16位）",
          "description": "在 myaccount.google.com/apppasswords 生成的 16 位应用专用密码（含不含空格均可）"
        }
      ]
    }
  }
}
